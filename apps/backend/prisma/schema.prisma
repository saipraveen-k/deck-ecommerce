// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String?
  googleId        String?
  role            Role      @default(CUSTOMER)
  
  // 2FA
  is2FAEnabled    Boolean   @default(false)
  twoFASecret     String?   // Encrypted
  twoFATempSecret String?
  lastLoginIp     String?
  lastLoginAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders          Order[]
  cart            Cart?
  addresses       Address[]
  reviews         Review[]
  adminLogs       AdminLoginLog[]

  @@map("users")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  categoryId  Int?      // Using Int for now, or just String depending on implementation
  brand       String?
  gender      String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]

  @@map("products")
}

model ProductVariant {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  size        String
  color       String
  sku         String    @unique
  price       Decimal   @db.Decimal(10, 2)
  mrp         Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0) // Critical for real-time updates
  status      ProductStatus @default(ACTIVE)

  cartItems   CartItem[]
  orderItems  OrderItem[]
  images      ProductImage[] 

  @@map("product_variants")
}

model ProductImage {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  imageUrl    String
  position    Int       @default(0)

  @@map("product_images")
}

model Cart {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  user        User      @relation(fields: [userId], references: [id])
  items       CartItem[]

  @@map("carts")
}

model CartItem {
  id          Int       @id @default(autoincrement())
  cartId      Int
  cart        Cart      @relation(fields: [cartId], references: [id])
  variantId   Int
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int

  @@map("cart_items")
}

model Order {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  totalAmount   Decimal   @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus @default(PENDING)
  addressId     Int
  address       Address   @relation(fields: [addressId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         OrderItem[]
  returns       Return[]

  @@map("orders")
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id])
  variantId   Int
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  price       Decimal   @db.Decimal(10, 2) // Snapshot of price at purchase

  returns     Return[]

  @@map("order_items")
}

model Address {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  name        String
  phone       String
  pincode     String
  city        String
  state       String
  addressLine String
  isDefault   Boolean   @default(false)

  orders      Order[]

  @@map("addresses")
}

model Return {
  id          Int       @id @default(autoincrement())
  orderId     Int       // Simplified linkage
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  reason      String
  status      String    // PENDING, APPROVED, REJECTED
  
  createdAt   DateTime  @default(now())

  @@map("returns")
}

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String    // PERCENTAGE, FLAT
  value       Decimal   @db.Decimal(10, 2)
  expiryDate  DateTime
  usageLimit  Int?
  usedCount   Int       @default(0)

  @@map("coupons")
}

model Review {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())

  @@map("reviews")
}

model AdminLoginLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  ipAddress   String
  device      String?
  status      String    // SUCCESS, FAILED
  timestamp   DateTime  @default(now())

  @@map("admin_login_logs")
}
